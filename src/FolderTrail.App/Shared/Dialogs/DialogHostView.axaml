<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:FolderTrail.App.Shared.Dialogs"
             x:Class="FolderTrail.App.Shared.Dialogs.DialogHostView"
             x:DataType="dialogs:DialogHostViewModel">
    <Panel>
        <Border Background="{DynamicResource FtOverlayBrush}" />
        <Border x:Name="Card" Classes="dialog" MinWidth="440"
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32"
                KeyboardNavigation.TabNavigation="Cycle">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Title}"
                           Classes="h2" TextWrapping="Wrap" Margin="0,0,0,14" />
                <ContentControl Content="{Binding Current}" />
            </DockPanel>
        </Border>
    </Panel>
</UserControl>
