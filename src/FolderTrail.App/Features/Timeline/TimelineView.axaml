<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FolderTrail.App.Features.Timeline"
             x:Class="FolderTrail.App.Features.Timeline.TimelineView"
             x:DataType="vm:TimelineViewModel">
    <DockPanel Margin="20,14,12,0">
        <StackPanel DockPanel.Dock="Top" Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
                <TextBox x:Name="SearchBox" Text="{Binding SearchText}"
                         PlaceholderText="Search file names and paths (Ctrl+F)"
                         AutomationProperties.Name="Search activity">
                    <TextBox.InnerLeftContent>
                        <PathIcon Data="{StaticResource IconSearch}" Width="14" Height="14" Margin="10,0,2,0"
                                  Foreground="{DynamicResource FtTextTertiaryBrush}" />
                    </TextBox.InnerLeftContent>
                </TextBox>
                <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding ExportCsvCommand}"
                        ToolTip.Tip="Save the filtered results as a CSV file (Ctrl+E)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource IconExport}" />
                        <TextBlock Text="Export CSV" />
                    </StackPanel>
                </Button>
            </Grid>

            <WrapPanel>
                <WrapPanel.Styles>
                    <Style Selector="WrapPanel > :is(Control)">
                        <Setter Property="Margin" Value="0,0,8,6" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </WrapPanel.Styles>
                <ToggleButton Classes="filter" Content="Created" IsChecked="{Binding ShowCreated}" />
                <ToggleButton Classes="filter" Content="Modified" IsChecked="{Binding ShowModified}" />
                <ToggleButton Classes="filter" Content="Deleted" IsChecked="{Binding ShowDeleted}" />
                <ToggleButton Classes="filter" Content="Renamed" IsChecked="{Binding ShowRenamed}" />
                <ComboBox ItemsSource="{Binding RootOptions}" SelectedItem="{Binding SelectedRoot}" MinWidth="170" MaxWidth="240"
                          AutomationProperties.Name="Folder filter" ToolTip.Tip="Folder">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:RootFilterOption">
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SelectedSource}" MinWidth="150"
                          AutomationProperties.Name="Source filter" ToolTip.Tip="Where the record came from">
                </ComboBox>
                <ComboBox ItemsSource="{Binding DateRangeOptions}" SelectedItem="{Binding SelectedDateRange}" MinWidth="140"
                          AutomationProperties.Name="Date range filter" ToolTip.Tip="Date range">
                </ComboBox>
                <CalendarDatePicker SelectedDate="{Binding CustomFrom}" IsVisible="{Binding IsCustomRange}"
                                    PlaceholderText="From" AutomationProperties.Name="From date" Width="140" />
                <CalendarDatePicker SelectedDate="{Binding CustomTo}" IsVisible="{Binding IsCustomRange}"
                                    PlaceholderText="To" AutomationProperties.Name="To date" Width="140" />
                <Button Classes="link" Content="Clear filters" Command="{Binding ClearFiltersCommand}"
                        IsVisible="{Binding ShowClearFilters}" />
            </WrapPanel>

            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,2">
                <TextBlock Text="{Binding ResultSummary}" Classes="caption" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="link" Content="{Binding PendingNewText}" Command="{Binding ShowNewCommand}"
                        IsVisible="{Binding HasPendingNew}" />
            </Grid>
        </StackPanel>

        <Panel>
            <ListBox x:Name="TimelineList" Classes="timeline" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                     AutomationProperties.Name="Activity timeline">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem" x:DataType="vm:TimelineRow">
                        <Setter Property="Focusable" Value="{Binding IsSelectable}" />
                        <Setter Property="IsHitTestVisible" Value="{Binding IsSelectable}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                    </Style>
                </ListBox.Styles>
                <ListBox.DataTemplates>
                    <DataTemplate DataType="vm:DayHeaderRow">
                        <TextBlock Text="{Binding Title}" Classes="label" Margin="0,12,0,0" />
                    </DataTemplate>
                    <DataTemplate DataType="vm:EventRow">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Border Classes="badge" Classes.created="{Binding IsCreated}" Classes.modified="{Binding IsModified}"
                                    Classes.deleted="{Binding IsDeleted}" Classes.renamed="{Binding IsRenamed}" VerticalAlignment="Center">
                                <Panel>
                                    <PathIcon Data="{StaticResource IconPlus}" IsVisible="{Binding IsCreated}" />
                                    <PathIcon Data="{StaticResource IconPencil}" IsVisible="{Binding IsModified}" />
                                    <PathIcon Data="{StaticResource IconDelete}" IsVisible="{Binding IsDeleted}" />
                                    <PathIcon Data="{StaticResource IconRename}" IsVisible="{Binding IsRenamed}" />
                                </Panel>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="1">
                                <Grid ColumnDefinitions="Auto,Auto,*">
                                    <TextBlock Text="{Binding Verb}" FontWeight="SemiBold" />
                                    <PathIcon Grid.Column="1" Data="{StaticResource IconFolder}" Width="12" Height="12" Margin="6,0,0,0"
                                              IsVisible="{Binding IsFolder}" Foreground="{DynamicResource FtTextTertiaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <TextBlock Text="{Binding Detail}" Classes="caption" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="{Binding TimeText}" HorizontalAlignment="Right" Classes="secondary" FontSize="12.5" />
                                <Border Classes="chip" Classes.info="{Binding IsInferred}" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SourceText}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.DataTemplates>
            </ListBox>

            <StackPanel IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="440" Spacing="10" Margin="24">
                <PathIcon Data="{StaticResource IconHistory}" Width="40" Height="40" Foreground="{DynamicResource FtTextTertiaryBrush}" />
                <TextBlock Text="{Binding EmptyTitle}" Classes="h2" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EmptyMessage}" Classes="secondary wrap" TextAlignment="Center" />
                <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" IsVisible="{Binding ShowClearFilters}"
                        HorizontalAlignment="Center" />
            </StackPanel>

            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" VerticalAlignment="Top" MinHeight="3" Height="3" />
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoadingMore}" VerticalAlignment="Bottom" MinHeight="3" Height="3" />
        </Panel>
    </DockPanel>
</UserControl>
