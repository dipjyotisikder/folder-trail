<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FolderTrail.App.Features.WatchedFolders"
             x:Class="FolderTrail.App.Features.WatchedFolders.ExclusionsDialogView"
             x:DataType="vm:ExclusionsDialogViewModel"
             Width="540">
    <StackPanel Spacing="12">
        <TextBlock Text="{Binding Description}" Classes="secondary wrap" />

        <Border Classes="callout neutral" IsVisible="{Binding HasInherited}">
            <TextBlock Text="{Binding InheritedText}" Classes="caption wrap" />
        </Border>

        <Border BorderBrush="{DynamicResource FtBorderBrush}" BorderThickness="1" CornerRadius="6" MaxHeight="280">
            <Panel>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Rules}" Margin="4">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ExclusionRowViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto" Margin="6,3">
                                    <CheckBox IsChecked="{Binding IsEnabled}" MinWidth="0" ToolTip.Tip="Use this exclusion"
                                              AutomationProperties.Name="{Binding AutomationName}" />
                                    <TextBox Grid.Column="1" Text="{Binding Pattern}" Margin="4,0,8,0"
                                             AutomationProperties.Name="Pattern" />
                                    <Border Grid.Column="2" Classes="chip" IsVisible="{Binding IsBuiltIn}" Margin="0,0,6,0">
                                        <TextBlock Text="Suggested" />
                                    </Border>
                                    <Button Grid.Column="3" Classes="icon subtle" ToolTip.Tip="Remove this pattern"
                                            AutomationProperties.Name="Remove pattern"
                                            Command="{Binding $parent[ItemsControl].((vm:ExclusionsDialogViewModel)DataContext).RemoveRuleCommand}"
                                            CommandParameter="{Binding}">
                                        <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12" />
                                    </Button>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Error}"
                                               IsVisible="{Binding HasError}" Foreground="{DynamicResource FtDangerBrush}"
                                               Classes="wrap" FontSize="12" Margin="4,2,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock IsVisible="{Binding IsEmpty}" Text="No exclusions. Every change is recorded."
                           Classes="caption" HorizontalAlignment="Center" Margin="16" />
            </Panel>
        </Border>

        <Grid ColumnDefinitions="*,Auto">
            <TextBox Text="{Binding NewPattern}" PlaceholderText="Add a name or pattern, for example *.bak or build/output"
                     AutomationProperties.Name="New exclusion pattern">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddPatternCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Content="Add" Command="{Binding AddPatternCommand}" Margin="8,0,0,0" />
        </Grid>
        <TextBlock Text="{Binding NewPatternError}" IsVisible="{Binding NewPatternError, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Foreground="{DynamicResource FtDangerBrush}" Classes="wrap" FontSize="12" />
        <TextBlock Text="{Binding SyntaxHelp}" Classes="caption wrap" />
        <TextBlock Text="{Binding SaveError}" IsVisible="{Binding SaveError, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Foreground="{DynamicResource FtDangerBrush}" Classes="wrap" />

        <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Content="Restore suggested defaults" Command="{Binding RestoreSuggestedCommand}" IsVisible="{Binding IsGlobal}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Classes="accent" Content="Save" Command="{Binding SaveCommand}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
